{
  "name": "war-command",
  "private": true,
  "version": "0.1.0",
  "description": "WAR COMMAND — simulateur de commandement d'opérations aériennes (jeu, scénarios fictifs)",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @warcommand/web dev",
    "build": "pnpm --filter @warcommand/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tools/tsconfig.json --noEmit && pnpm --filter @warcommand/web typecheck",
    "sim": "tsx tools/run-headless.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@warcommand/ai-commander": "workspace:*",
    "@warcommand/air-operations": "workspace:*",
    "@warcommand/doctrine-engine": "workspace:*",
    "@warcommand/land-operations": "workspace:*",
    "@warcommand/mission-editor": "workspace:*",
    "@warcommand/multi-domain-effects": "workspace:*",
    "@warcommand/naval-operations": "workspace:*",
    "@warcommand/replay-engine": "workspace:*",
    "@warcommand/scenario-system": "workspace:*",
    "@warcommand/simulation-core": "workspace:*",
    "@warcommand/unit-database": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
